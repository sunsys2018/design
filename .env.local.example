# Copy this file to .env.local. It is gitignored.
#
# Every data source this dashboard uses is keyless, so no credentials are
# required to run it. The only mandatory value is the API server port.

# ── API server ────────────────────────────────────────────────────────────────
SERVER_PORT=3001

# ── Optional: FRED (Federal Reserve Economic Data) ────────────────────────────
# Unlocks the US bank prime rate (series DPRIME) in the Rates panel, which has
# no keyless source. Everything else in that panel — US 30/15-yr mortgage rates
# from Freddie Mac, Canadian prime and 5-yr mortgage from the Bank of Canada —
# works without this. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=
